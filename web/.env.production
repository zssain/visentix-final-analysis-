# Production build config for the Cloudflare Worker frontend (visentix-v2-mvp).
# `vite build` auto-loads this in production mode, so a production bundle points
# at the live API — NOT localhost (web/.env is dev-only: 127.0.0.1:8000).
#
# Deploy target of record (docs/runbooks/PILOT-DAY-RUNBOOK.md):
#   Frontend : https://visentix-v2-mvp.zssaincoding.workers.dev  (Cloudflare Worker)
#   API      : https://visentix-api.westeurope.cloudapp.azure.com (Azure VM + Caddy)
#
# This holds a public URL only — no secret. It is force-tracked past .gitignore's
# `.env.*` rule so the correct host travels with the repo and CI/deploy builds.
VITE_API_BASE_URL=https://visentix-api.westeurope.cloudapp.azure.com
