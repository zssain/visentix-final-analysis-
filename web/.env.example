VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGci...
# API URL of the deployed FastAPI backend.
# Dev uses 127.0.0.1:8000 (web/.env); the production build reads web/.env.production,
# whose value is the deploy target of record: https://visentix-api.westeurope.cloudapp.azure.com
VITE_API_BASE_URL=http://127.0.0.1:8000
# Set to "true" ONLY on internal builds to expose the post-MVP preview surfaces
# (Quarterly, Bulk, Crosswalk, Rewrite, Trust Center, Partner, Vendors) in the
# nav. These still render mock data (M-15..M-28) — leave unset/false for pilot.
VITE_PREVIEW_SURFACES=false
