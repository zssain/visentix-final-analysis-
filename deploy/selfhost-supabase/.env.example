# Self-hosted Supabase — environment.
# Copy to `.env` in this directory and fill the four secrets from gen-keys.py:
#   python3 scripts/gen-keys.py
# The .env file is gitignored (contains secrets). This example is committed.

# ── Secrets (from gen-keys.py) ───────────────────────────────────────────────
POSTGRES_PASSWORD=REPLACE_ME
JWT_SECRET=REPLACE_ME_min_40_chars
ANON_KEY=REPLACE_ME_anon_jwt
SERVICE_ROLE_KEY=REPLACE_ME_service_role_jwt

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# ── GoTrue (Auth) ────────────────────────────────────────────────────────────
# Internal-only stack: the Visentix app reaches Kong at http://kong:8000 over the
# shared `visentix` docker network. The browser never calls Supabase directly
# (web/src uses no supabase-js), so no public HTTPS/CORS exposure is needed.
API_EXTERNAL_URL=http://kong:8000
GOTRUE_SITE_URL=https://visentix-v2-mvp.zssaincoding.workers.dev
# Users are created only by the server (scripts/db/provision_demo_users.py via the
# GoTrue admin API), never by public signup.
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_AUD=authenticated
# No SMTP in the pilot — admin-provisioned users are auto-confirmed.
GOTRUE_MAILER_AUTOCONFIRM=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Files live on the VM disk (no object-store bill). The raw-artifacts bucket.
FILE_SIZE_LIMIT=52428800
STORAGE_BACKEND=file
FILE_STORAGE_BACKEND_PATH=/var/lib/storage

# ── Image tags (mirror the official supabase/docker; bump together if one fails
#    to pull — see github.com/supabase/supabase/blob/master/docker) ────────────
# IMPORTANT: POSTGRES major version MUST be >= your Cloud project's version, or
# pg_dump/pg_restore refuse to move the data. Cloud (2026-09) is PG17.6, so this
# is pinned to a matching PG17 build. Check yours: SELECT version();
POSTGRES_IMAGE=supabase/postgres:17.6.1.168
GOTRUE_IMAGE=supabase/gotrue:v2.174.0
POSTGREST_IMAGE=postgrest/postgrest:v12.2.12
STORAGE_IMAGE=supabase/storage-api:v1.19.3
IMGPROXY_IMAGE=darthsim/imgproxy:v3.8.0
KONG_IMAGE=kong:2.8.1
META_IMAGE=supabase/postgres-meta:v0.87.1
