# ---- App ----
APP_ENV=development                 # development | production
CORS_ALLOWED_ORIGINS=http://localhost:5173   # comma-separated; lock to web origin in prod

# ---- Supabase ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...       # public-ish; used by clients, protected by RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci... # SECRET — server only, bypasses RLS, never to browser
SUPABASE_JWT_SECRET=super-secret...  # to verify Supabase-issued JWTs server-side
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ---- Local LLM (dev + batch, Ollama on your Mac) ----
OLLAMA_BASE_URL=http://localhost:11434
QWEN_LOCAL_MODEL=qwen3:8b

# ---- Embeddings (local, CPU/Metal) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- Hosted Qwen (live / prod) ----
HOSTED_QWEN_BASE_URL=https://api.your-provider.com/v1
HOSTED_QWEN_API_KEY=sk-...          # SECRET
HOSTED_QWEN_MODEL=Qwen/Qwen3-8B-Instruct   # the provider's model id

# ---- Admin bootstrap ----
ADMIN_EMAIL=you@example.com         # seeds the first admin profile (P2.2)
