# =============================================================================
# Visentix — environment template  (COPY to .env; .env is gitignored, NEVER commit)
# Every key here is consumed by app/config.py (Settings) unless marked
# [deploy-only] (read by deploy/*.sh + docker-compose.prod.yml, not by the app).
# deploy/deploy_runpod.sh refuses to run if any key below is ABSENT from .env.
# =============================================================================

# ---- App ----
APP_ENV=development                 # development | production  (production ⇒ is_production)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173  # comma-sep; in prod set to https://DOMAIN only
RENDERER=weasyprint                 # weasyprint (default) | playwright (needs Chromium)

# ---- Supabase (managed DB stays hosted) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJhbGci...       # public-ish; used by clients, protected by RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci... # SECRET — server only, bypasses RLS, never to browser
SUPABASE_JWT_SECRET=super-secret...  # verifies Supabase-issued JWTs server-side (HS256 fallback)
DATABASE_URL=postgresql://postgres:DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
DATABASE_POOLER_URL=                 # IPv4 Supabase pooler (APScheduler jobstore); required if SCHEDULER_ENABLED=true

# ---- Local LLM (Ollama on the RunPod GPU) ----
OLLAMA_BASE_URL=http://localhost:11434   # in compose the api service uses http://ollama:11434
QWEN_LOCAL_MODEL=qwen3:8b            # PINNED model pulled into Ollama at first boot

# ---- Embeddings (in-process, sentence-transformers — NOT an Ollama model) ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # 384-dim; cached in the hf-cache volume

# ---- Hosted Qwen = our private RunPod Ollama, reached over the tailnet ----
# When set, app/services/llm.py uses the hosted branch: native /api/chat, SAME
# payload as local (think:false, num_predict:500). API key is OPTIONAL on the
# tailnet (Ollama needs none). BASE_URL is the pod's Tailscale IP (verified from
# the Azure VM before lock-in — see deploy/runpod/README.md).
HOSTED_QWEN_BASE_URL=                # prod: http://<runpod-tailscale-ip>:11434  (e.g. http://100.69.10.127:11434)
HOSTED_QWEN_API_KEY=                 # OPTIONAL — blank on the tailnet; SECRET if ever set
HOSTED_QWEN_MODEL=qwen3:8b           # Ollama model tag on the pod

# ---- Tailscale (joins Azure VM + RunPod pod on one private tailnet) ----
TAILSCALE_AUTHKEY=                   # SECRET — reusable, non-ephemeral auth key (login.tailscale.com)

# ---- Versioning metadata (VICBNF v2 quintet — stamped on every score/finding) ----
SCORING_MODEL_VERSION=vicbnf-2.0.0
SOURCE_CORPUS_VERSION=corpus-2026Q2

# ---- Enforcement correlation (F-004) ----
ENABLE_LIVE_F004=false              # true ⇒ compute live F-004 via embeddings

# ---- F07 scheduler (in-process APScheduler) ----
SCHEDULER_ENABLED=false             # true on the prod server ONLY (never in tests/import)

# ---- F07 alert delivery (SMTP; unset ⇒ no send) ----
SMTP_HOST=                           # SECRET-adjacent; leave empty to suppress email alerts
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=                           # SECRET
SMTP_FROM=alerts@visentix.local
PUBLIC_BASE_URL=https://app.visentix.local   # base URL used in alert links (set to https://DOMAIN)

# ---- Ingestion / external data sources (batch scripts only) ----
INGESTION_POLITENESS_SECONDS=0.0     # >0 in prod to be a good citizen between per-item work
COURTLISTENER_TOKEN=                 # CourtListener API token (enforcement ingest)
OPENSTATES_API_KEY=                  # OpenStates API key (state-law ingest)
GOVINFO_API_KEY=                     # GovInfo API key (federal legal refs)
EDGAR_BULK_PATH=                     # local SEC EDGAR bulk root (batch importer, not a crawler)
PRINCETON_EXTRACT_DIR=               # local per-sector CSVs (princeton_leuven connector)

# ---- Admin bootstrap ----
ADMIN_EMAIL=you@example.com          # seeds the first admin profile (P2.2)

# ---- Partner API keys (SEC-009) ----
# Server-side pepper for HMAC-SHA256 hashing of partner API keys. When set, new
# keys are stored as HMAC(pepper, key); verify still accepts legacy sha256 for
# migration. Leave empty for local/dev (falls back to legacy sha256 + a warning).
PARTNER_KEY_PEPPER=

# =============================================================================
# [deploy-only] — read by deploy/*, docker-compose.prod.yml, Caddy, backups.
# NOT consumed by app/config.py.
# =============================================================================

# ---- Public domain / TLS (Caddy issues automatic TLS for this host) ----
DOMAIN=app.example.com               # the ONLY public hostname; Caddy :443 → api:8000
ACME_EMAIL=ops@example.com           # Let's Encrypt account email for cert notices

# ---- Container image tags (recorded as digests in LAUNCH-READINESS-v2.md) ----
GIT_TAG=v1.0-pilot                   # repo tag deployed; also tags the built api image
OLLAMA_IMAGE=ollama/ollama:latest    # pin + record resolved digest post-pull

# ---- Off-VM backups (nightly pg_dump → gzip → S3-compatible via rclone) ----
BACKUP_RCLONE_REMOTE=offsite         # rclone remote name (see RCLONE_CONFIG_BASE64)
BACKUP_BUCKET=visentix-db-backups    # bucket/container on that remote
BACKUP_PREFIX=prod                   # key prefix within the bucket
BACKUP_RETAIN_DAYS=14                # nightly retention window
RCLONE_CONFIG_BASE64=                # SECRET — base64 of an rclone.conf holding the S3 creds
                                     #   generate: base64 -w0 ~/.config/rclone/rclone.conf
